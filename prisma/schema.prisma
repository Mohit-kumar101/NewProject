generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  passwordHash      String?
  tier              String             @default("free")
  purchases         Purchase[]
  subscriptions     Subscription[]
  receipts          Receipt[]
  alerts            Alert[]
  savedCalculations SavedCalculation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

/// Raw document ingested via upload or email forward.
model Receipt {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String     @default("pending") // pending | processing | parsed | confirmed | failed
  sourceType    String     @default("upload") // upload | email
  fileName      String?
  mimeType      String?
  fileSizeBytes Int?
  storageKey    String?
  rawText       String?
  extractedJson String?
  errorMessage  String?
  purchases     Purchase[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

model Purchase {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptId        String?
  receipt          Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  itemName         String
  retailer         String?
  sku              String?
  category         String?
  price            Float
  currency         String    @default("USD")
  purchaseDate     DateTime
  returnDeadline   DateTime?
  warrantyDeadline DateTime?
  returnWindowDays Int?
  receiptImageUrl  String?
  status           String    @default("active")
  notes            String?
  alerts           Alert[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([receiptId])
  @@index([returnDeadline])
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  cost               Float
  currency           String   @default("USD")
  billingCycle       String
  nextRenewalDate    DateTime
  status             String   @default("active")
  reminderDaysBefore Int      @default(3)
  alerts             Alert[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([nextRenewalDate])
}

/// Persisted notification log — generated by cron or on purchase confirm.
model Alert {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // return_expiry | warranty_expiry | subscription_renewal | price_drop
  title          String
  body           String
  templateBody   String?
  urgency        String        @default("medium") // high | medium | low
  status         String        @default("pending") // pending | sent | dismissed
  dueAt          DateTime
  sentAt         DateTime?
  dismissedAt    DateTime?
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([dueAt])
  @@index([status])
}

model SavedCalculation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolSlug   String
  toolTitle  String
  inputsJson String
  resultJson String
  label      String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([toolSlug])
}
